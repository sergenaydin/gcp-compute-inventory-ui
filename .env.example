# Copy: cp .env.example .env — .env is never committed.

# Where the dev server (npm run dev) and `npm run preview` forward /api requests.
API_PROXY_TARGET=http://localhost:8080

# Only for a build that talks to an API on another origin (npm run build).
# Leave empty to call the same origin. The API must allow this UI's origin
# via its CORS_ORIGIN setting.
VITE_API_BASE_URL=
